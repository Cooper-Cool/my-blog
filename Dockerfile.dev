FROM node:20-slim

# 安装 Rust 工具链（用于索引生成）
RUN apt-get update \
  && apt-get install -y --no-install-recommends cargo rustc \
  && rm -rf /var/lib/apt/lists/*

# 安装 pnpm
RUN npm install -g pnpm

WORKDIR /app

# 只复制依赖配置文件（利用 Docker 缓存）
COPY package.json pnpm-lock.yaml ./

# 安装依赖（只在 package.json 变化时重新安装）
RUN pnpm install

# 复制源代码
COPY . .

EXPOSE 4321

# 直接启动（不删除 node_modules）
CMD ["sh", "-c", "pnpm run dev -- --host 0.0.0.0 --port 4321"]
